<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SmogBusterProject/MainMenu.uss"/>
    <ui:VisualElement name="root-container" class="root-container">

        <!-- Fondo: cielo, sol, nubes de smog y ciudad -->
        <ui:VisualElement name="background" class="background" picking-mode="Ignore">
            <ui:VisualElement class="sky sky--top" picking-mode="Ignore"/>
            <ui:VisualElement class="sky sky--mid" picking-mode="Ignore"/>
            <ui:VisualElement class="sky sky--low" picking-mode="Ignore"/>
            <ui:VisualElement class="sun" picking-mode="Ignore"/>
            <ui:VisualElement name="skyline" class="skyline" picking-mode="Ignore">
                <ui:VisualElement class="building" style="height: 38%; flex-grow: 1.2;" picking-mode="Ignore"/>
                <ui:VisualElement class="building building--light" style="height: 62%; flex-grow: 0.8;" picking-mode="Ignore"/>
                <ui:VisualElement class="building" style="height: 46%; flex-grow: 1;" picking-mode="Ignore"/>
                <ui:VisualElement class="building building--light" style="height: 80%; flex-grow: 0.7;" picking-mode="Ignore"/>
                <ui:VisualElement class="building" style="height: 54%; flex-grow: 1.3;" picking-mode="Ignore"/>
                <ui:VisualElement class="building building--light" style="height: 34%; flex-grow: 0.9;" picking-mode="Ignore"/>
                <ui:VisualElement class="building" style="height: 70%; flex-grow: 0.8;" picking-mode="Ignore"/>
                <ui:VisualElement class="building building--light" style="height: 44%; flex-grow: 1.1;" picking-mode="Ignore"/>
                <ui:VisualElement class="building" style="height: 58%; flex-grow: 0.9;" picking-mode="Ignore"/>
            </ui:VisualElement>
            <ui:VisualElement name="smog-layer" class="smog-layer" picking-mode="Ignore">
                <ui:VisualElement class="smog smog--a" picking-mode="Ignore"/>
                <ui:VisualElement class="smog smog--b" picking-mode="Ignore"/>
                <ui:VisualElement class="smog smog--c" picking-mode="Ignore"/>
                <ui:VisualElement class="smog smog--d" picking-mode="Ignore"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Contenido respetando el área segura (notch) -->
        <ui:VisualElement name="safe-area" class="safe-area" picking-mode="Ignore">

            <!-- Pantalla principal -->
            <ui:VisualElement name="menu" class="menu">
                <ui:VisualElement class="title-block">
                    <ui:Label text="SMOG" name="title-label" class="title"/>
                    <ui:Label text="BUSTER" class="title title--accent"/>
                </ui:VisualElement>
                <ui:Label text="Limpia el aire de la ciudad" name="subtitle-label" class="subtitle"/>
                <ui:VisualElement class="button-column">
                    <ui:Button text="JUGAR" name="btn-play" class="menu-button menu-button--primary"/>
                    <ui:Button text="OPCIONES" name="btn-options" class="menu-button"/>
                    <ui:Button text="SALIR" name="btn-exit" class="menu-button menu-button--ghost"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label text="v0.1" name="version-label" class="version"/>
        </ui:VisualElement>

        <!-- Panel de opciones -->
        <ui:VisualElement name="options-overlay" class="overlay">
            <ui:VisualElement name="options-panel" class="panel">
                <ui:Label text="OPCIONES" class="panel-title"/>
                <ui:Slider label="Música" name="slider-music" low-value="0" high-value="1" value="0.8" class="option-slider"/>
                <ui:Slider label="Efectos" name="slider-sfx" low-value="0" high-value="1" value="0.8" class="option-slider"/>
                <ui:Toggle label="Vibración" name="toggle-vibration" value="true" class="option-toggle"/>
                <ui:Button text="VOLVER" name="btn-options-back" class="menu-button menu-button--primary panel-button"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Fundido para transición de escena -->
        <ui:VisualElement name="fade" class="fade" picking-mode="Ignore"/>
    </ui:VisualElement>
</ui:UXML>
