<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SmogBusterProject/UI/MainMenu/MainMenu.uss?fileID=7433441132597879392&amp;guid=dab1087fa4394394d9e848f95bd88bf5&amp;type=3#MainMenu"/>
    <ui:VisualElement name="root-container" class="root-container">
        <!-- Fondo animado a partir del key art (MainMenuBackground.cs). Las posiciones son % de la imagen de 1376x768 -->
        <ui:VisualElement name="background" picking-mode="Ignore" class="background">
            <ui:VisualElement name="bg-stage" picking-mode="Ignore" class="bg-stage">
                <ui:VisualElement picking-mode="Ignore" class="bg-base"/>
                <ui:VisualElement name="bg-smoke" picking-mode="Ignore" class="bg-fill"/>
                <ui:VisualElement name="bg-beam" picking-mode="Ignore" class="bg-beam"/>
                <ui:VisualElement name="bg-impact" picking-mode="Ignore" class="bg-flare bg-impact"/>
                <ui:VisualElement name="bg-drone" picking-mode="Ignore" class="bg-drone">
                    <ui:VisualElement picking-mode="Ignore" class="bg-flare bg-rotor bg-rotor--1"/>
                    <ui:VisualElement picking-mode="Ignore" class="bg-flare bg-rotor bg-rotor--2"/>
                    <ui:VisualElement picking-mode="Ignore" class="bg-flare bg-rotor bg-rotor--3"/>
                    <ui:VisualElement picking-mode="Ignore" class="bg-flare bg-rotor bg-rotor--4"/>
                </ui:VisualElement>
                <ui:VisualElement name="bg-logo-glow" picking-mode="Ignore" class="bg-logo-glow"/>
                <ui:VisualElement name="bg-logo" picking-mode="Ignore" class="bg-logo"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="safe-area" picking-mode="Ignore" class="safe-area">
            <ui:VisualElement name="menu" class="menu">
                <!-- El título y el lema vienen en el logo del fondo -->
                <ui:VisualElement name="VisualElement" class="button-column">
                    <ui:Button text="JUGAR" name="btn-play" class="menu-button menu-button--primary"/>
                    <ui:Button text="OPCIONES" name="btn-options" class="menu-button"/>
                    <ui:Button text="CRÉDITOS" name="btn-credits" class="menu-button menu-button--ghost"/>
                    <ui:Button text="SALIR" name="btn-exit" class="menu-button menu-button--ghost"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="v0.1" name="version-label" class="version"/>
        </ui:VisualElement>
        <ui:VisualElement name="options-overlay" class="overlay">
            <ui:VisualElement name="options-panel" class="panel">
                <ui:Label text="OPCIONES" class="panel-title"/>
                <ui:Slider label="Música" name="slider-music" low-value="0" high-value="1" value="0.8" class="option-slider"/>
                <ui:Slider label="Efectos" name="slider-sfx" low-value="0" high-value="1" value="0.8" class="option-slider"/>
                <ui:Toggle label="Vibración" name="toggle-vibration" value="true" class="option-toggle"/>
                <ui:Toggle label="Joystick fijo" name="toggle-fixed-joystick" value="false" class="option-toggle"/>
                <!-- Pulsar cambia entre Fácil, Normal y Difícil -->
                <ui:Button text="DIFICULTAD: NORMAL" name="btn-difficulty" class="menu-button"/>
                <ui:Button text="VOLVER" name="btn-options-back" class="menu-button menu-button--primary panel-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Créditos y atribuciones (GDD 9.4) -->
        <ui:VisualElement name="credits-overlay" class="overlay">
            <ui:VisualElement name="credits-panel" class="panel credits-panel">
                <ui:Label text="CRÉDITOS" class="panel-title"/>
                <ui:ScrollView name="credits-scroll" class="credits-scroll" mode="Vertical">
                    <ui:Label text="Diseño y desarrollo" class="credits-heading"/>
                    <ui:Label text="Equipo Smog Buster" class="credits-line"/>
                    <ui:Label text="Dron Buster-1" class="credits-heading"/>
                    <ui:Label text="Modelo propio hecho en Blender" class="credits-line"/>
                    <ui:Label text="Ciudad" class="credits-heading"/>
                    <ui:Label text="POLYGON City Pack (Unity Asset Store)" class="credits-line"/>
                    <ui:Label text="Cielos" class="credits-heading"/>
                    <ui:Label text="Kloofendal Overcast Pure Sky y Spruit Sunrise" class="credits-line"/>
                    <ui:Label text="Poly Haven (CC0)" class="credits-line"/>
                    <ui:Label text="Música y efectos" class="credits-heading"/>
                    <ui:Label text="Epidemic Sound" class="credits-line"/>
                    <ui:Label text="Efectos y música de juego provisionales: sintetizados para Smog Buster" class="credits-line"/>
                    <ui:Label text="Tipografía" class="credits-heading"/>
                    <ui:Label text="Fredoka, The Fredoka Project Authors" class="credits-line"/>
                    <ui:Label text="SIL Open Font License 1.1" class="credits-line"/>
                    <ui:Label text="Motor" class="credits-heading"/>
                    <ui:Label text="Unity con Universal Render Pipeline" class="credits-line"/>
                </ui:ScrollView>
                <ui:Button text="VOLVER" name="btn-credits-back" class="menu-button menu-button--primary panel-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Selección de nivel (GDD 9.3): JUGAR abre este panel -->
        <ui:VisualElement name="levels-overlay" class="overlay">
            <ui:VisualElement name="levels-panel" class="panel">
                <ui:Label text="ELIGE NIVEL" class="panel-title"/>
                <ui:Button text="1 · CENTRO DE VILLALIMPIA" name="btn-level-1" class="menu-button menu-button--primary level-button"/>
                <ui:Label text="" name="level-1-best" class="level-best"/>
                <ui:Button text="2 · PRÓXIMAMENTE" name="btn-level-2" class="menu-button level-button"/>
                <ui:Button text="3 · PRÓXIMAMENTE" name="btn-level-3" class="menu-button level-button"/>
                <ui:Button text="VOLVER" name="btn-levels-back" class="menu-button menu-button--ghost panel-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="fade" picking-mode="Ignore" class="fade"/>
    </ui:VisualElement>
</ui:UXML>
