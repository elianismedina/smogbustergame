/* Pantalla de derrota. Reutiliza .menu-button, .button-column y .fade de MainMenu.uss */

.gameover-root {
    flex-grow: 1;
}

.gameover-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 32px;
    background-color: rgba(40, 6, 6, 0.7);
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.gameover-overlay--visible {
    opacity: 1;
}

.gameover-panel {
    width: 100%;
    max-width: 760px;
    padding: 48px 56px;
    align-items: center;
    background-color: rgb(20, 40, 50);
    border-width: 3px;
    border-color: rgb(235, 90, 80);
    border-radius: 32px;
    scale: 0.9 0.9;
    transition-property: scale;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.gameover-overlay--visible .gameover-panel {
    scale: 1 1;
}

.gameover-title {
    font-size: 96px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 8px;
    color: rgb(240, 95, 85);
    text-shadow: 0 6px 12px rgba(0, 0, 0, 0.6);
}

.gameover-subtitle {
    font-size: 32px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(185, 205, 210);
    margin-top: 8px;
    margin-bottom: 40px;
}
