/* Pantalla de resultados (victoria o derrota). Reutiliza .menu-button, .button-column y .fade de MainMenu.uss */

.gameover-root {
    flex-grow: 1;
}

.gameover-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 32px;
    background-color: rgba(40, 6, 6, 0.7);
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.gameover-overlay--visible {
    opacity: 1;
}

.gameover-panel {
    width: 100%;
    max-width: 760px;
    padding: 48px 56px;
    align-items: center;
    background-color: rgb(20, 40, 50);
    border-width: 3px;
    border-color: rgb(235, 90, 80);
    border-radius: 32px;
    scale: 0.9 0.9;
    transition-property: scale;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.gameover-overlay--visible .gameover-panel {
    scale: 1 1;
}

.gameover-title {
    font-size: 80px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 8px;
    color: rgb(240, 95, 85);
    text-shadow: 0 6px 12px rgba(0, 0, 0, 0.6);
}

.gameover-subtitle {
    font-size: 32px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(185, 205, 210);
    margin-top: 8px;
    margin-bottom: 16px;
}

.gameover-hint {
    font-size: 26px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(150, 175, 180);
    margin-bottom: 40px;
}

/* Victoria: verde en lugar de rojo */
.gameover-overlay--victory {
    background-color: rgba(6, 40, 22, 0.7);
}

.gameover-overlay--victory .gameover-panel {
    border-color: rgb(120, 230, 170);
}

.gameover-overlay--victory .gameover-title {
    color: rgb(120, 230, 170);
}

/* ---------- Resumen de impacto ---------- */

.gameover-stats {
    width: 100%;
    margin-bottom: 24px;
    padding: 16px 28px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 20px;
}

.gameover-stat {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 0;
}

.gameover-stat__label {
    font-size: 28px;
    color: rgb(185, 205, 210);
}

.gameover-stat__value {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(225, 235, 230);
}

.gameover-stat--total {
    margin-top: 8px;
    padding-top: 12px;
    border-top-width: 2px;
    border-color: rgba(185, 205, 210, 0.3);
}

.gameover-stat--total .gameover-stat__label,
.gameover-stat--total .gameover-stat__value {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 214, 102);
}
