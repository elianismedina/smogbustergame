<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!-- Reutiliza botones, panel, sliders, overlay y fundido del menú principal -->
    <Style src="project://database/Assets/SmogBusterProject/UI/MainMenu/MainMenu.uss"/>
    <Style src="project://database/Assets/SmogBusterProject/UI/HUD/GameHUD.uss"/>
    <ui:VisualElement name="game-hud-root" class="game-hud-root" picking-mode="Ignore">

        <!-- Mira del Rayo (GameHudController la coloca donde apunta el rayo) -->
        <ui:VisualElement name="crosshair" class="crosshair" picking-mode="Ignore">
            <!-- Contorno oscuro detrás de las esquinas: la mira se ve también sobre el cielo claro -->
            <ui:VisualElement class="crosshair__corner crosshair__corner--outline crosshair__corner--tl" picking-mode="Ignore"/>
            <ui:VisualElement class="crosshair__corner crosshair__corner--outline crosshair__corner--tr" picking-mode="Ignore"/>
            <ui:VisualElement class="crosshair__corner crosshair__corner--outline crosshair__corner--bl" picking-mode="Ignore"/>
            <ui:VisualElement class="crosshair__corner crosshair__corner--outline crosshair__corner--br" picking-mode="Ignore"/>
            <!-- Cuatro esquinas en escuadra -->
            <ui:VisualElement class="crosshair__corner crosshair__corner--tl" picking-mode="Ignore"/>
            <ui:VisualElement class="crosshair__corner crosshair__corner--tr" picking-mode="Ignore"/>
            <ui:VisualElement class="crosshair__corner crosshair__corner--bl" picking-mode="Ignore"/>
            <ui:VisualElement class="crosshair__corner crosshair__corner--br" picking-mode="Ignore"/>
        </ui:VisualElement>

        <!-- Marcadores sobre las nubes de smog (CloudMarkersController); debajo de los controles -->
        <ui:VisualElement name="cloud-markers" class="cloud-markers" picking-mode="Ignore"/>

        <!-- Controles dentro del área segura (notch) -->
        <ui:VisualElement name="game-hud-safe-area" class="game-hud-safe-area" picking-mode="Ignore">
            <!-- Controles táctiles (GDD 6.2): joystick a la izquierda; subir, bajar y Rayo a la derecha.
                 Los botones se mantienen pulsados (GameHudController). -->
            <ui:VisualElement name="touch-controls" class="touch-controls" picking-mode="Ignore">
                <ui:VisualElement name="touch-zone-left" class="touch-zone touch-zone--left"/>
                <ui:VisualElement name="btn-up" class="altitude-button altitude-button--up">
                    <ui:Label text="▲" class="altitude-button__label" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:VisualElement name="btn-down" class="altitude-button altitude-button--down">
                    <ui:Label text="▼" class="altitude-button__label" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:VisualElement name="btn-seed" class="action-button action-button--seed">
                    <ui:Label text="SEMILLA" class="action-button__label" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:VisualElement name="btn-beam" class="action-button action-button--beam">
                    <ui:Label text="RAYO" class="action-button__label" picking-mode="Ignore"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- Aviso de borde del mapa (GDD 5.4); GameHudController lo muestra cerca de las paredes -->
            <ui:Label text="FUERA DE ALCANCE · vuelve a la ciudad" name="hud-boundary" class="hud-boundary" picking-mode="Ignore"/>
            <!-- Frase de inicio en el centro, a la vez que la voz (GameplayAudio.StartVoicePlayed) -->
            <ui:Label text="Let&apos;s clean the air of this city!" name="hud-start-line" class="hud-start-line" picking-mode="Ignore"/>
            <!-- Puntaje y árboles plantados (GDD 9.3), arriba al centro -->
            <ui:VisualElement name="hud-stats" class="hud-stats" picking-mode="Ignore">
                <ui:Label text="0" name="hud-score" class="hud-stat hud-stat--score" picking-mode="Ignore"/>
                <ui:Label text="ÁRBOLES 0/0" name="hud-trees" class="hud-stat hud-stat--trees" picking-mode="Ignore"/>
            </ui:VisualElement>
            <ui:Label text="03:00" name="hud-timer" class="hud-timer" picking-mode="Ignore"/>
            <ui:Button text="II" name="btn-pause" class="pause-button"/>
            <!-- Cambio de cámara (tercera / primera persona), debajo de la pausa.
                 GameHudController le pone el icono vectorial (CameraSwitchIcon) y lo resalta en primera persona. -->
            <ui:Button name="btn-camera" class="camera-button"/>
        </ui:VisualElement>

        <!-- Menú de pausa -->
        <ui:VisualElement name="pause-overlay" class="overlay">
            <ui:VisualElement name="pause-panel" class="panel">
                <ui:Label text="PAUSA" class="panel-title"/>
                <ui:Slider label="Música" name="pause-slider-music" low-value="0" high-value="1" value="0.8" class="option-slider"/>
                <ui:Slider label="Efectos" name="pause-slider-sfx" low-value="0" high-value="1" value="0.8" class="option-slider"/>
                <ui:Toggle label="Vibración" name="pause-toggle-vibration" value="true" class="option-toggle"/>
                <ui:Toggle label="Joystick fijo" name="pause-toggle-fixed-joystick" value="false" class="option-toggle"/>
                <ui:Button text="CONTINUAR" name="btn-resume" class="menu-button menu-button--primary panel-button"/>
                <ui:VisualElement class="pause-row">
                    <ui:Button text="REINTENTAR" name="btn-pause-retry" class="menu-button pause-row__button pause-row__button--left"/>
                    <ui:Button text="MENÚ" name="btn-pause-menu" class="menu-button menu-button--ghost pause-row__button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="fade" class="fade" picking-mode="Ignore"/>
    </ui:VisualElement>
</ui:UXML>
