/* HUD de juego: joysticks táctiles, botón de pausa y menú de pausa.
   Resolución de referencia 1920x1080 (PanelSettings, Expand). */

.game-hud-root {
    flex-grow: 1;
}

.game-hud-safe-area {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---------- Joysticks ---------- */

.touch-zones {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 62%;
    flex-direction: row;
    justify-content: space-between;
}

.touch-zone {
    width: 42%;
    height: 100%;
}

.joystick {
    flex-grow: 1;
}

.joystick__base {
    position: absolute;
    width: 240px;
    height: 240px;
    /* La posición (left/top) es el centro: se compensa con translate */
    translate: -50% -50%;
    border-radius: 120px;
    border-width: 4px;
    border-color: rgba(225, 235, 230, 0.45);
    background-color: rgba(14, 28, 38, 0.28);
    align-items: center;
    justify-content: center;
    opacity: 0.55;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.joystick__knob {
    width: 104px;
    height: 104px;
    border-radius: 52px;
    background-color: rgba(225, 235, 230, 0.8);
    border-width: 3px;
    border-color: rgba(14, 28, 38, 0.35);
}

.joystick--active .joystick__base {
    opacity: 1;
}

.joystick--move .joystick__knob {
    background-color: rgba(120, 230, 170, 0.85);
}

.joystick--altitude .joystick__knob {
    background-color: rgba(230, 200, 110, 0.85);
}

/* ---------- Botón de pausa ---------- */

.pause-button {
    position: absolute;
    top: 28px;
    right: 36px;
    width: 104px;
    height: 104px;
    margin: 0;
    padding: 0;
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(225, 235, 230);
    background-color: rgba(14, 28, 38, 0.72);
    border-width: 3px;
    border-color: rgba(120, 230, 170, 0.6);
    border-radius: 24px;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.pause-button:hover,
.pause-button:focus {
    background-color: rgba(44, 102, 104, 0.9);
}

.pause-button:active {
    scale: 0.92 0.92;
}

/* ---------- Menú de pausa ---------- */

.pause-row {
    flex-direction: row;
    justify-content: space-between;
}

.pause-row__button {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 32px;
}

.pause-row__button--left {
    margin-right: 16px;
}
