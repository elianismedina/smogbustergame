/* HUD: medidor de smog. Resolución de referencia 1920x1080 (PanelSettings). */

.hud-root {
    flex-grow: 1;
}

.hud-safe-area {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 28px 36px;
}

.smog-meter {
    width: 440px;
    padding: 14px 20px 18px 20px;
    background-color: rgba(14, 28, 38, 0.72);
    border-width: 3px;
    border-color: rgba(120, 230, 170, 0.6);
    border-radius: 20px;
    transition-property: border-color, scale;
    transition-duration: 0.45s;
}

.smog-meter__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.smog-meter__title {
    font-size: 28px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    color: rgb(225, 235, 230);
    padding: 0;
    margin: 0;
}

.smog-meter__value {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(225, 235, 230);
    padding: 0;
    margin: 0;
}

.smog-meter__track {
    height: 26px;
    border-radius: 13px;
    background-color: rgba(255, 255, 255, 0.12);
    overflow: hidden;
}

.smog-meter__fill {
    height: 100%;
    width: 80%;
    border-radius: 13px;
    background-color: rgb(200, 150, 80);
}

/* Nivel crítico: el borde parpadea (el controlador alterna la clase --pulse) */
.smog-meter--critical {
    border-color: rgba(235, 90, 80, 0.85);
}

.smog-meter--critical.smog-meter--pulse {
    border-color: rgba(235, 90, 80, 0.25);
    scale: 1.02 1.02;
}
